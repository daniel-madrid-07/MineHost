{
  "name": "minehost",
  "version": "1.5.2",
  "description": "Create and manage Minecraft servers on your own PC, without touching the router.",
  "author": "daniel-madrid-07",
  "license": "MIT",
  "homepage": "https://github.com/daniel-madrid-07/MineHost",
  "repository": {
    "type": "git",
    "url": "https://github.com/daniel-madrid-07/MineHost.git"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --dir && node scripts/stamp-icon.js && node scripts/trim-build.js && electron-builder --win --prepackaged release/win-unpacked"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  },
  "build": {
    "appId": "com.minehost.app",
    "productName": "MineHost",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MineHost",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerSidebar": "assets/installerSidebar.bmp",
      "uninstallerSidebar": "assets/installerSidebar.bmp",
      "installerHeader": "assets/installerHeader.bmp",
      "artifactName": "MineHost-Setup-${version}.${ext}"
    }
  }
}
